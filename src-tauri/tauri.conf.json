{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Organization OS",
  "version": "0.1.0",
  "identifier": "dev.aiorganization.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AI Organization OS", "width": 1440, "height": 900, "minWidth": 1080, "minHeight": 700, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "targets": "all" }
}
