{
  "name": "ai-organization-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config v4/vite.config.ts",
    "build": "tsc --noEmit && npm run build:v4",
    "build:v3": "tsc --noEmit -p v3/tsconfig.json && vite build --config v3/vite.config.ts",
    "build:v4": "tsc --noEmit -p v4/tsconfig.json && vite build --config v4/vite.config.ts",
    "dev:v4": "vite --config v4/vite.config.ts",
    "preview": "vite preview --config v4/vite.config.ts",
    "tauri": "tauri",
    "tauri:v4": "tauri dev",
    "pretauri:v4": "node scripts/clean-rust-incremental.mjs && node scripts/report-rust-debug-size.mjs --record=tauri-start",
    "posttauri:v4": "node scripts/clean-rust-incremental.mjs && node scripts/report-rust-debug-size.mjs --record=tauri-dev",
    "tauri:v4:build": "tauri build --no-bundle",
    "pretauri:v4:build": "node scripts/clean-rust-incremental.mjs && node scripts/report-rust-debug-size.mjs --record=tauri-build-start",
    "posttauri:v4:build": "node scripts/clean-rust-incremental.mjs && node scripts/report-rust-debug-size.mjs --record=tauri-build",
    "rust:storage": "node scripts/report-rust-debug-size.mjs --record=manual",
    "test": "vitest run",
    "provider:test": "cargo run --locked --manifest-path src-tauri/Cargo.toml --bin provider-harness --"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
